# Copy to .env (or set in your host). Nothing here is required for local development.
PORT=3000
NODE_ENV=development

# Leave DATABASE_URL empty locally to use the built-in PostgreSQL (PGlite) in ./data/pglite.
# DATABASE_URL=postgres://user:password@localhost:5432/gcc
# DATABASE_SSL=true            # verify TLS (or "no-verify"); not needed on a private network

# First super admin on an empty production database (password at least 12 characters).
# BOOTSTRAP_ADMIN_EMAIL=you@example.com
# BOOTSTRAP_ADMIN_PASSWORD=

# Demo accounts and sample data: true by default in development, false in production.
# SEED_DEMO=true
